# Copy this file to .env and fill in real values, then restart the dev server.
# NEVER commit .env. On Vercel the same names go in Settings → Environment Variables.

# ── Admin sign-in (REQUIRED in production: without these the admin area stays closed) ──
ADMIN_USERNAME=
ADMIN_PASSWORD=          # 12+ characters, random
ADMIN_SECRET=            # 24+ random characters (signs login sessions)
ADMIN_KEY_SECRET=        # 24+ random characters (encrypts key files; then run: npm run gen-key)
ADMIN_REVOKED_KEY_IDS=   # optional, comma separated key IDs to lock out
CRON_SECRET=             # REQUIRED on Vercel: protects the daily backup URL (16+ random characters)

# ── Google Analytics 4 (optional) ──
VITE_GA_ID=

# ── Contact-form email sender (Gmail + App Password) ──
SMTP_USER=designadzonex@gmail.com
SMTP_PASS=

# ── Supabase — used on Vercel only (local `npm run dev` stores data in .local-data/) ──
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# ── Human check on public forms (optional, Cloudflare Turnstile, free) ──
VITE_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET=
